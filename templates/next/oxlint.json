{
  "plugins": [
    "react",
    "unicorn",
    "typescript",
    "oxc",
    "import",
    "jsx-a11y"
  ],
  "jsPlugins": [
    "eslint-plugin-oxfmt",
    {
      "name": "import-js",
      "specifier": "eslint-plugin-import"
    },
    {
      "name": "react-js",
      "specifier": "eslint-plugin-react"
    },
    "eslint-plugin-check-file"
  ],
  "categories": {},
  "rules": {
    "constructor-super": "deny",
    "for-direction": "deny",
    "getter-return": "deny",
    "no-array-constructor": "deny",
    "no-async-promise-executor": "deny",
    "no-case-declarations": "deny",
    "no-class-assign": "deny",
    "no-compare-neg-zero": "deny",
    "no-cond-assign": "deny",
    "no-const-assign": "deny",
    "no-constant-binary-expression": "deny",
    "no-constant-condition": "deny",
    "no-control-regex": "deny",
    "no-debugger": "deny",
    "no-delete-var": "deny",
    "no-dupe-class-members": "deny",
    "no-dupe-else-if": "deny",
    "no-dupe-keys": "deny",
    "no-duplicate-case": "deny",
    "no-empty": "deny",
    "no-empty-character-class": "deny",
    "no-empty-pattern": "deny",
    "no-empty-static-block": "deny",
    "no-ex-assign": "deny",
    "no-extra-boolean-cast": "deny",
    "no-fallthrough": "deny",
    "no-func-assign": "deny",
    "no-global-assign": "deny",
    "no-import-assign": "deny",
    "no-invalid-regexp": "deny",
    "no-irregular-whitespace": "deny",
    "no-loss-of-precision": "deny",
    "no-misleading-character-class": "deny",
    "no-new-native-nonconstructor": "deny",
    "no-nonoctal-decimal-escape": "deny",
    "no-obj-calls": "deny",
    "no-prototype-builtins": "deny",
    "no-redeclare": "deny",
    "no-regex-spaces": "deny",
    "no-self-assign": "deny",
    "no-setter-return": "deny",
    "no-shadow-restricted-names": "deny",
    "no-sparse-arrays": "deny",
    "no-this-before-super": "deny",
    "no-undef": "deny",
    "no-unexpected-multiline": "deny",
    "no-unreachable": "deny",
    "no-unsafe-finally": "deny",
    "no-unsafe-negation": "deny",
    "no-unsafe-optional-chaining": "deny",
    "no-unused-expressions": "deny",
    "no-unused-labels": "deny",
    "no-unused-private-class-members": "deny",
    "no-unused-vars": "deny",
    "no-useless-backreference": "deny",
    "no-useless-catch": "deny",
    "no-useless-escape": "deny",
    "no-with": "deny",
    "require-yield": "deny",
    "use-isnan": "deny",
    "valid-typeof": "deny",
    "import/default": "deny",
    "import/export": "deny",
    "import/named": "deny",
    "import/namespace": "deny",
    "import/no-duplicates": "warn",
    "import/no-named-as-default": "warn",
    "import/no-named-as-default-member": "warn",
    "jsx_a11y/alt-text": "deny",
    "jsx_a11y/anchor-has-content": "deny",
    "jsx_a11y/anchor-is-valid": "deny",
    "jsx_a11y/aria-activedescendant-has-tabindex": "deny",
    "jsx_a11y/aria-props": "deny",
    "jsx_a11y/aria-proptypes": "deny",
    "jsx_a11y/aria-role": "deny",
    "jsx_a11y/aria-unsupported-elements": "deny",
    "jsx_a11y/autocomplete-valid": "deny",
    "jsx_a11y/click-events-have-key-events": "deny",
    "jsx_a11y/heading-has-content": "deny",
    "jsx_a11y/html-has-lang": "deny",
    "jsx_a11y/iframe-has-title": "deny",
    "jsx_a11y/img-redundant-alt": "deny",
    "jsx_a11y/interactive-supports-focus": "deny",
    "jsx_a11y/label-has-associated-control": "deny",
    "jsx_a11y/media-has-caption": "deny",
    "jsx_a11y/mouse-events-have-key-events": "deny",
    "jsx_a11y/no-access-key": "deny",
    "jsx_a11y/no-autofocus": "deny",
    "jsx_a11y/no-distracting-elements": "deny",
    "jsx_a11y/no-interactive-element-to-noninteractive-role": "deny",
    "jsx_a11y/no-noninteractive-element-interactions": "deny",
    "jsx_a11y/no-noninteractive-element-to-interactive-role": "deny",
    "jsx_a11y/no-noninteractive-tabindex": "deny",
    "jsx_a11y/no-redundant-roles": "deny",
    "jsx_a11y/no-static-element-interactions": "deny",
    "jsx_a11y/role-has-required-aria-props": "deny",
    "jsx_a11y/role-supports-aria-props": "deny",
    "jsx_a11y/scope": "deny",
    "jsx_a11y/tabindex-no-positive": "deny",
    "react/display-name": "deny",
    "react/error-boundaries": "deny",
    "react/exhaustive-deps": "warn",
    "react/globals": "deny",
    "react/immutability": "deny",
    "react/incompatible-library": "warn",
    "react/jsx-key": "deny",
    "react/jsx-no-comment-textnodes": "deny",
    "react/jsx-no-duplicate-props": "deny",
    "react/jsx-no-target-blank": "deny",
    "react/jsx-no-undef": "deny",
    "react/no-children-prop": "deny",
    "react/no-danger-with-children": "deny",
    "react/no-direct-mutation-state": "deny",
    "react/no-find-dom-node": "deny",
    "react/no-is-mounted": "deny",
    "react/no-render-return-value": "deny",
    "react/no-string-refs": "deny",
    "react/no-unescaped-entities": "deny",
    "react/no-unknown-property": "deny",
    "react/preserve-manual-memoization": "deny",
    "react/purity": "deny",
    "react/react-in-jsx-scope": "deny",
    "react/refs": "deny",
    "react/require-render-return": "deny",
    "react/rules-of-hooks": "deny",
    "react/set-state-in-effect": "deny",
    "react/set-state-in-render": "deny",
    "react/static-components": "deny",
    "react/unsupported-syntax": "warn",
    "react/use-memo": "deny",
    "typescript/ban-ts-comment": "deny",
    "typescript/no-duplicate-enum-values": "deny",
    "typescript/no-empty-object-type": "deny",
    "typescript/no-explicit-any": "deny",
    "typescript/no-extra-non-null-assertion": "deny",
    "typescript/no-misused-new": "deny",
    "typescript/no-namespace": "deny",
    "typescript/no-non-null-asserted-optional-chain": "deny",
    "typescript/no-require-imports": "deny",
    "typescript/no-this-alias": "deny",
    "typescript/no-unnecessary-type-constraint": "deny",
    "typescript/no-unsafe-declaration-merging": "deny",
    "typescript/no-unsafe-function-type": "deny",
    "typescript/no-wrapper-object-types": "deny",
    "typescript/prefer-as-const": "deny",
    "typescript/prefer-namespace-keyword": "deny",
    "typescript/triple-slash-reference": "deny"
  },
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": "19.0.0",
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    },
    "jest": {
      "version": null
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "overrides": [
    {
      "files": [
        "**/*.{mts,cts}"
      ],
      "env": null,
      "globals": null,
      "plugins": null,
      "rules": {
        "constructor-super": "allow",
        "getter-return": "allow",
        "no-class-assign": "allow",
        "no-const-assign": "allow",
        "no-dupe-class-members": "allow",
        "no-dupe-keys": "allow",
        "no-func-assign": "allow",
        "no-import-assign": "allow",
        "no-new-native-nonconstructor": "allow",
        "no-obj-calls": "allow",
        "no-redeclare": "allow",
        "no-setter-return": "allow",
        "no-this-before-super": "allow",
        "no-undef": "allow",
        "no-unreachable": "allow",
        "no-unsafe-negation": "allow",
        "no-var": "deny",
        "no-with": "allow",
        "prefer-const": "deny",
        "prefer-rest-params": "deny",
        "prefer-spread": "deny"
      }
    },
    {
      "files": [
        "**/*.{ts,tsx}"
      ],
      "env": null,
      "globals": null,
      "plugins": null,
      "rules": {
        "constructor-super": "allow",
        "getter-return": "allow",
        "no-class-assign": "allow",
        "no-const-assign": "allow",
        "no-dupe-class-members": "allow",
        "no-dupe-keys": "allow",
        "no-func-assign": "allow",
        "no-import-assign": "allow",
        "no-new-native-nonconstructor": "allow",
        "no-obj-calls": "allow",
        "no-redeclare": "allow",
        "no-setter-return": "allow",
        "no-this-before-super": "allow",
        "no-undef": "allow",
        "no-unreachable": "deny",
        "no-unsafe-negation": "allow",
        "no-var": "deny",
        "no-with": "allow",
        "prefer-const": "deny",
        "prefer-rest-params": "deny",
        "prefer-spread": "deny",
        "no-void": "allow",
        "no-empty": "allow",
        "no-empty-pattern": "allow",
        "no-useless-escape": "allow",
        "no-case-declarations": "allow",
        "no-eval": "deny",
        "no-alert": "deny",
        "no-param-reassign": "deny",
        "no-empty-function": "deny",
        "no-useless-rename": "deny",
        "no-useless-return": "deny",
        "max-lines": [
          "deny",
          [
            {
              "max": 500,
              "skipComments": true,
              "skipBlankLines": true
            }
          ]
        ],
        "max-params": [
          "deny",
          [
            {
              "max": 5,
              "countVoidThis": false
            }
          ]
        ],
        "arrow-body-style": "allow",
        "prefer-arrow-callback": [
          "deny",
          [
            {
              "allowNamedFunctions": false
            }
          ]
        ],
        "func-style": [
          "deny",
          [
            "declaration",
            {
              "allowArrowFunctions": false
            }
          ]
        ],
        "import/named": "allow",
        "import/no-default-export": "deny",
        "react/react-in-jsx-scope": "allow",
        "react/no-danger-with-children": "warn",
        "react/refs": "allow",
        "react/purity": "allow",
        "react/set-state-in-effect": "allow",
        "react/incompatible-library": "allow",
        "jsx_a11y/click-events-have-key-events": "allow",
        "jsx_a11y/label-has-associated-control": "allow",
        "jsx_a11y/no-static-element-interactions": "allow",
        "typescript/no-floating-promises": "deny",
        "no-unused-vars": [
          "warn",
          [
            {
              "argsIgnorePattern": "^__?",
              "caughtErrors": "all",
              "caughtErrorsIgnorePattern": "^__?",
              "destructuredArrayIgnorePattern": "^__?",
              "varsIgnorePattern": "^__?",
              "ignoreRestSiblings": true
            }
          ]
        ],
        "check-file/folder-naming-convention": [
          "deny",
          [
            {
              "*/**": "KEBAB_CASE"
            },
            {
              "ignoreWords": [
                "__tests__",
                "__trash__",
                ".gql"
              ]
            }
          ]
        ],
        "check-file/filename-naming-convention": [
          "deny",
          [
            {
              "**/*.*": "KEBAB_CASE"
            },
            {
              "ignoreMiddleExtensions": true
            }
          ]
        ]
      }
    },
    {
      "files": [
        "**/*.config.{js,ts,mjs}",
        "src/app/**"
      ],
      "env": null,
      "globals": null,
      "plugins": null,
      "rules": {
        "import/no-default-export": "allow"
      }
    }
  ],
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "*.config.{js,ts,mjs,mts}"
  ]
}
